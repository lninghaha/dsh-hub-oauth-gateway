{
  "extends": "./base.json",
  "compilerOptions": {
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "noEmit": true,
    "jsx": "react-jsx",
    "lib": ["DOM", "DOM.Iterable", "ES2022"],
    "types": ["vitest/globals", "node", "react", "react-dom"]
  },
  "include": [
    "../src/client/**/*.ts",
    "../src/client/**/*.tsx",
    "../src/client/**/*.d.ts",
    "../src/shared/**/*.ts",
    "../tests/v1/client/**/*.ts",
    "../tests/v1/client/**/*.tsx"
  ]
}
