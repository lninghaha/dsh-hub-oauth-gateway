{
  "name": "dsh-hub-oauth-gateway",
  "description": "Local-first usage, cost, quota, account, and forecast analytics for DeepSeek Harness Web; coding-plan OAuth sign-in and an API gateway are planned next",
  "version": "1.1.0",
  "private": false,
  "packageManager": "pnpm@11.21.0",
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lninghaha/dsh-hub-oauth-gateway.git"
  },
  "homepage": "https://github.com/lninghaha/dsh-hub-oauth-gateway#readme",
  "bugs": "https://github.com/lninghaha/dsh-hub-oauth-gateway/issues",
  "keywords": [
    "deepseek",
    "deepseek-harness",
    "dsh",
    "token-usage",
    "cost-analytics",
    "quota-dashboard",
    "oauth",
    "api-gateway"
  ],
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "bin": {
    "dsh-hub-oauth-gateway-install": "scripts/install.mjs",
    "dsh-coding-oauth": "lib/bin.js",
    "dsh-grok-build": "lib/bin.js"
  },
  "files": [
    "lib/",
    "cordis.patch.yml",
    "scripts/install.mjs",
    "README.md",
    "CHANGELOG.md",
    "CONTRIBUTING.md",
    "CODE_OF_CONDUCT.md",
    "SECURITY.md",
    "LICENSE",
    "docs/00-project-rules.md",
    "docs/architecture.md",
    "docs/configuration.md",
    "docs/migration-v1.md",
    "docs/research/usage-analytics-landscape.md"
  ],
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "import": "./lib/index.js",
      "default": "./lib/index.js"
    },
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-ui-primitives",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-ui-sidebar",
        "@deepseek-ai/dsh-client-ui-slots"
      ]
    }
  },
  "scripts": {
    "clean:next": "node build/clean-next.mjs",
    "typecheck:next": "tsc -b tsconfig.host.json tsconfig.client.json",
    "build:server:next": "tsc -p tsconfig.build.json && node build/build-server.mjs",
    "build:client:next": "node build/build-client.mjs",
    "build:next": "pnpm run clean:next && pnpm run typecheck:next && pnpm run build:server:next && pnpm run build:client:next",
    "build": "pnpm run release:build",
    "test:next": "vitest run",
    "test:next:watch": "vitest",
    "test": "pnpm run build:next && pnpm run test:next",
    "lint:next": "biome check",
    "check:next": "pnpm run lint:next && pnpm run build:next && pnpm run test:next",
    "release:promote": "node build/promote-release.mjs",
    "release:verify": "node build/verify-release.mjs && node scripts/test-bundle.mjs && node scripts/test-install.mjs",
    "release:build": "pnpm run build:next && pnpm run release:promote && pnpm run release:verify",
    "release:inspect": "node scripts/release.mjs --dry-run",
    "release:pack": "node scripts/release.mjs --pack",
    "check": "pnpm run lint:next && pnpm run release:build && pnpm run test:next",
    "prepack": "pnpm run release:build"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.8",
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-client-locale": "0.1.0-rc.6",
    "@deepseek-ai/dsh-client-runtime": "0.1.0-rc.6",
    "@deepseek-ai/dsh-client-ui-layout": "0.1.0-rc.6",
    "@deepseek-ai/dsh-client-ui-primitives": "0.1.0-rc.6",
    "@deepseek-ai/dsh-client-ui-settings": "0.1.0-rc.6",
    "@deepseek-ai/dsh-client-ui-sidebar": "0.1.0-rc.6",
    "@deepseek-ai/dsh-client-ui-slots": "0.1.0-rc.6",
    "@deepseek-ai/dsh-client-web": "0.1.0-rc.6",
    "@deepseek-ai/dsh-llm": "0.1.0-rc.6",
    "@deepseek-ai/dsh-session": "0.1.0-rc.6",
    "@tanstack/react-query": "^5.101.4",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.4",
    "@types/node": "^22.20.1",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@vitest/coverage-v8": "^4.1.10",
    "esbuild": "^0.28.2",
    "jsdom": "^30.0.1",
    "lightningcss": "^1.33.0",
    "msw": "^2.15.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "typescript": "^6.0.3",
    "uplot": "^1.6.32",
    "vitest": "^4.1.10"
  },
  "dependencies": {
    "zod": "^4.4.3"
  },
  "peerDependencies": {
    "@deepseek-ai/dsh-session": ">=0.1.0-rc.6 <0.2.0"
  },
  "license": "MIT"
}
