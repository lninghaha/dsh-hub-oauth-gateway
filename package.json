{
  "name": "dsh-hub-oauth-gateway",
  "description": "Local-first usage, cost, quota, account, and forecast analytics for DeepSeek Harness Web, with coding-subscription OAuth sign-in (Grok Build, Codex, Kimi Code, Claude Code), an optional loopback API gateway, and opt-in local auth/usage monitoring",
	"version": "1.10.0",
  "private": false,
  "packageManager": "pnpm@11.21.0",
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lninghaha/dsh-hub-oauth-gateway.git"
  },
  "homepage": "https://github.com/lninghaha/dsh-hub-oauth-gateway#readme",
  "bugs": "https://github.com/lninghaha/dsh-hub-oauth-gateway/issues",
  "keywords": [
    "deepseek",
    "deepseek-harness",
    "dsh",
    "token-usage",
    "cost-analytics",
    "quota-dashboard",
    "oauth",
    "api-gateway",
    "dsh-plugin",
    "usage"
  ],
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "bin": {
    "dsh-coding-oauth": "lib/bin.js",
    "dsh-grok-build": "lib/bin.js",
    "dsh-hub-oauth-gateway-install": "scripts/install.mjs"
  },
  "files": [
    "lib/",
    "cordis.patch.yml",
    "scripts/install.mjs",
    "README.md",
    "README.zh-CN.md",
    "README.ja.md",
    "README.ko.md",
    "README.pt-BR.md",
    "README.es.md",
    "README.fr.md",
    "README.de.md",
    "README.ru.md",
    "CHANGELOG.md",
    "LICENSE",
    "NOTICE",
    "LICENSES/Apache-2.0.txt",
    ".github/CONTRIBUTING.md",
    ".github/CODE_OF_CONDUCT.md",
    ".github/SECURITY.md",
    "docs/00-project-rules.md",
    "docs/01-install.md",
    "docs/oauth-provenance.md",
    "docs/02-architecture.md",
    "docs/02-architecture.zh-CN.md",
    "docs/03-configuration.md",
    "docs/04-migration-v1.md",
    "docs/research/usage-analytics-landscape.md",
    "docs/research/token-monitor.md",
    "docs/research/token-monitor-supplement-proposal.md",
    "docs/research/ccswitch-provider-usage.md",
    "compatibility/dsh-bom.json"
  ],
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "import": "./lib/index.js",
      "default": "./lib/index.js"
    },
    "./client": "./lib/client.js",
    "./invariant": {
      "types": "./lib/invariant.d.ts",
      "default": "./lib/invariant.js"
    },
    "./package.json": "./package.json"
  },
  "dsh": {
    "compatibility": {
      "coreAbi": "dsh-coding-oauth-core/v1",
      "verifiedBom": "./compatibility/dsh-bom.json",
      "verified": {
        "id": "dsh-0.1.1-rc.2",
        "dshVersion": "0.1.1-rc.2",
        "packages": {
          "@deepseek-ai/cordis": "4.0.1",
          "@deepseek-ai/dsh-atomic-write": "0.1.1-rc.2",
          "@deepseek-ai/dsh-attachment": "0.1.1-rc.2",
          "@deepseek-ai/dsh-client-locale": "0.1.1-rc.2",
          "@deepseek-ai/dsh-client-runtime": "0.1.1-rc.2",
          "@deepseek-ai/dsh-client-ui-layout": "0.1.1-rc.2",
          "@deepseek-ai/dsh-client-ui-primitives": "0.1.1-rc.2",
          "@deepseek-ai/dsh-client-ui-settings": "0.1.1-rc.2",
          "@deepseek-ai/dsh-client-ui-sidebar": "0.1.1-rc.2",
          "@deepseek-ai/dsh-client-ui-slots": "0.1.1-rc.2",
          "@deepseek-ai/dsh-client-web": "0.1.1-rc.2",
          "@deepseek-ai/dsh-credentials": "0.1.1-rc.2",
          "@deepseek-ai/dsh-home-paths": "0.1.1-rc.2",
          "@deepseek-ai/dsh-host-webserver": "0.1.1-rc.2",
          "@deepseek-ai/dsh-invariants": "0.1.1-rc.2",
          "@deepseek-ai/dsh-llm": "0.1.1-rc.2",
          "@deepseek-ai/dsh-llm-pi-ai": "0.1.1-rc.2",
          "@deepseek-ai/dsh-session": "0.1.1-rc.2",
          "@deepseek-ai/dsh-tools": "0.1.1-rc.2",
          "@deepseek-ai/schemastery": "3.18.1",
          "@earendil-works/pi-ai": "0.84.2",
          "react": "18.3.1",
          "react-dom": "18.3.1"
        }
      }
    },
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-ui-primitives",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-ui-sidebar",
        "@deepseek-ai/dsh-client-ui-slots"
      ]
    }
  },
  "scripts": {
    "assert:node": "node scripts/assert-node.mjs",
    "check:dsh-bom": "node scripts/check-dsh-bom.mjs",
    "clean:next": "node build/clean-next.mjs",
    "typecheck:next": "tsc -b tsconfig/host.json tsconfig/client.json",
    "build:server:next": "tsc -p tsconfig/build.json && tsc -p tsconfig/dts-bin.json && node build/build-server.mjs",
    "build:client:next": "node build/build-client.mjs",
    "build:next": "pnpm run assert:node && pnpm run check:dsh-bom && pnpm run clean:next && pnpm run typecheck:next && pnpm run build:server:next && pnpm run build:client:next",
    "build": "pnpm run release:build",
    "test:next": "vitest run",
    "test:next:watch": "vitest",
    "test": "pnpm run build:next && pnpm run test:next",
    "lint:next": "biome check",
    "check:next": "pnpm run assert:node && pnpm run lint:next && pnpm run build:next && pnpm run test:next",
    "release:promote": "node build/promote-release.mjs",
    "release:verify": "node build/verify-release.mjs && node scripts/test-bundle.mjs && node scripts/test-install.mjs",
    "release:build": "pnpm run assert:node && pnpm run build:next && pnpm run release:promote && pnpm run release:verify",
    "release:inspect": "pnpm run assert:node && node scripts/release.mjs --dry-run",
    "release:pack": "pnpm run assert:node && node scripts/release.mjs --pack",
    "release:publish": "node scripts/release-publish.mjs",
    "check": "pnpm run assert:node && pnpm run lint:next && pnpm run release:build && pnpm run test:next",
    "prepack": "pnpm run release:build"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.8",
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-client-locale": "0.1.1-rc.2",
    "@deepseek-ai/dsh-client-runtime": "0.1.1-rc.2",
    "@deepseek-ai/dsh-client-ui-layout": "0.1.1-rc.2",
    "@deepseek-ai/dsh-client-ui-primitives": "0.1.1-rc.2",
    "@deepseek-ai/dsh-client-ui-settings": "0.1.1-rc.2",
    "@deepseek-ai/dsh-client-ui-sidebar": "0.1.1-rc.2",
    "@deepseek-ai/dsh-client-ui-slots": "0.1.1-rc.2",
    "@deepseek-ai/dsh-atomic-write": "0.1.1-rc.2",
    "@deepseek-ai/dsh-attachment": "0.1.1-rc.2",
    "@deepseek-ai/dsh-client-web": "0.1.1-rc.2",
    "@deepseek-ai/dsh-credentials": "0.1.1-rc.2",
    "@deepseek-ai/dsh-home-paths": "0.1.1-rc.2",
    "@deepseek-ai/dsh-host-webserver": "0.1.1-rc.2",
    "@deepseek-ai/dsh-invariants": "0.1.1-rc.2",
    "@deepseek-ai/dsh-llm": "0.1.1-rc.2",
    "@deepseek-ai/dsh-llm-pi-ai": "0.1.1-rc.2",
    "@deepseek-ai/dsh-session": "0.1.1-rc.2",
    "@deepseek-ai/dsh-tools": "0.1.1-rc.2",
    "@deepseek-ai/schemastery": "3.18.1",
    "@earendil-works/pi-ai": "0.84.2",
    "@tanstack/react-query": "^5.101.4",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.4",
    "@types/node": "^22.20.1",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@vitest/coverage-v8": "^4.1.10",
    "esbuild": "^0.28.2",
    "jsdom": "^30.0.1",
    "lightningcss": "^1.33.0",
    "msw": "^2.15.0",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "typescript": "^6.0.3",
    "uplot": "^1.6.32",
    "vitest": "^4.1.10"
  },
  "dependencies": {
    "dsh-coding-oauth-core": "0.1.0",
    "undici": "^7.24.8",
    "zod": "^4.4.3"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "4.0.1",
    "@deepseek-ai/dsh-atomic-write": "0.1.1-rc.2",
    "@deepseek-ai/dsh-attachment": "0.1.1-rc.2",
    "@deepseek-ai/dsh-credentials": "0.1.1-rc.2",
    "@deepseek-ai/dsh-home-paths": "0.1.1-rc.2",
    "@deepseek-ai/dsh-host-webserver": "0.1.1-rc.2",
    "@deepseek-ai/dsh-invariants": "0.1.1-rc.2",
    "@deepseek-ai/dsh-llm": "0.1.1-rc.2",
    "@deepseek-ai/dsh-llm-pi-ai": "0.1.1-rc.2",
    "@deepseek-ai/dsh-session": "0.1.1-rc.2",
    "@deepseek-ai/dsh-tools": "0.1.1-rc.2",
    "@deepseek-ai/schemastery": "3.18.1",
    "@earendil-works/pi-ai": "0.84.2"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/dsh-attachment": {
      "optional": true
    },
    "@deepseek-ai/dsh-credentials": {
      "optional": true
    },
    "@deepseek-ai/dsh-invariants": {
      "optional": true
    },
    "@deepseek-ai/dsh-tools": {
      "optional": true
    }
  },
  "license": "MIT AND Apache-2.0"
}
