{
	"$schema": "https://biomejs.dev/schemas/2.5.8/schema.json",
	"files": {
		"includes": [
			"src/**/*.ts",
			"src/**/*.tsx",
			"build/**/*.mjs",
			"tests/v1/**/*.ts",
			"tests/v1/**/*.tsx",
			"scripts/install.mjs",
			"scripts/test-install.mjs",
			"scripts/test-bundle.mjs",
			"scripts/release.mjs"
		]
	},
	"formatter": {
		"enabled": true,
		"indentStyle": "tab",
		"lineWidth": 120
	},
	"linter": {
		"enabled": true,
		"rules": {
			"preset": "recommended"
		}
	},
	"javascript": {
		"formatter": {
			"quoteStyle": "double",
			"semicolons": "always"
		}
	}
}
