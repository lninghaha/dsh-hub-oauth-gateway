{
  "name": "dsh-coding-oauth-core",
  "version": "0.1.2",
  "description": "Vendored build input for the DSH-neutral coding OAuth runtime coordinator.",
  "type": "module",
  "private": true,
  "license": "Apache-2.0",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./contracts": {
      "types": "./src/contracts.ts",
      "import": "./src/contracts.ts",
      "default": "./src/contracts.ts"
    },
    "./http-json": {
      "types": "./src/http-json.ts",
      "import": "./src/http-json.ts",
      "default": "./src/http-json.ts"
    },
    "./grok-errors": {
      "types": "./src/grok-errors.ts",
      "import": "./src/grok-errors.ts",
      "default": "./src/grok-errors.ts"
    },
    "./kimi-errors": {
      "types": "./src/kimi-errors.ts",
      "import": "./src/kimi-errors.ts",
      "default": "./src/kimi-errors.ts"
    },
    "./gateway-protocol": {
      "types": "./src/gateway-protocol.ts",
      "import": "./src/gateway-protocol.ts",
      "default": "./src/gateway-protocol.ts"
    }
  },
  "dependencies": {
    "undici": "7.29.0"
  },
  "peerDependencies": {
    "@deepseek-ai/dsh-llm": "0.1.1-rc.2"
